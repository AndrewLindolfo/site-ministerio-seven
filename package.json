{
  "name": "ministerio-seven-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:static": "node scripts/audit-static.mjs",
    "audit:real-pdfs": "node scripts/audit-real-pdf-library.mjs",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore-rules.test.js\"",
    "test:real-pdf": "firebase emulators:exec --only firestore --project demo-ministerio-seven-pdf \"node --test tests/real-pdf-import.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@grpc/grpc-js": "1.13.6",
    "firebase": "^12.6.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "dependencies": {
    "@tesseract.js-data/por": "^1.0.0",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0"
  }
}

{
  "name": "ministerio-seven-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:static": "node scripts/audit-static.mjs",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore-rules.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@grpc/grpc-js": "1.13.6",
    "firebase": "^12.6.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
